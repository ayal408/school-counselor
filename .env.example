POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-random-secret-at-least-32-characters
INTERNAL_SERVICE_KEY=replace-with-another-random-secret-at-least-32-characters
DATA_ENCRYPTION_KEY=generate-a-fernet-key-see-readme
CLIENT_ORIGIN=http://localhost:8088
COOKIE_SECURE=false

# Disabled until a provider and institutional consent/retention policy are configured.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# Configure only the providers you want to allow. Keys stay server-side.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b

# Google web OAuth credentials stay on the data server and email worker only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional existing sender fallback; connection can also be completed in Settings.
GMAIL_EMAIL=
GMAIL_REFRESH_TOKEN=
# Defaults to CLIENT_ORIGIN + /api/email/gmail/callback
GMAIL_REDIRECT_URI=
